{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/senior-in-180-days/days.schema.json",
  "title": "Daily roadmap catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["num", "week", "phase", "month", "focus", "artifact", "dsa"],
    "properties": {
      "num": {"type": "integer", "minimum": 1, "maximum": 180},
      "week": {"type": "integer", "minimum": 1, "maximum": 18},
      "phase": {"type": "string"},
      "month": {"type": "integer", "minimum": 1, "maximum": 6},
      "focus": {"type": "string"},
      "artifact": {"type": "string"},
      "dsa": {
        "type": "object",
        "required": ["target", "easy", "medium", "hard"],
        "properties": {
          "target": {"type": "integer", "minimum": 0},
          "easy": {"type": "integer", "minimum": 0},
          "medium": {"type": "integer", "minimum": 0},
          "hard": {"type": "integer", "minimum": 0},
          "total": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      },
      "csBlock": {"type": "string"},
      "aiArtifact": {"type": "string"},
      "aiLayer": {"type": "string"},
      "resource": {"type": "string"},
      "aiMlArtifact": {"type": "string"}
    },
    "additionalProperties": false
  }
}
