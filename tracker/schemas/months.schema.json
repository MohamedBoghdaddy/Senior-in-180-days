{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/senior-in-180-days/months.schema.json",
  "title": "Month phase catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "num", "start", "end", "title", "desc", "color", "dimColor", "darkColor"],
    "properties": {
      "id": {"type": "string", "pattern": "^month-\\d{2}$"},
      "num": {"type": "integer", "minimum": 1, "maximum": 6},
      "start": {"type": "integer", "minimum": 1, "maximum": 180},
      "end": {"type": "integer", "minimum": 1, "maximum": 180},
      "title": {"type": "string"},
      "desc": {"type": "string"},
      "color": {"type": "string"},
      "dimColor": {"type": "string"},
      "darkColor": {"type": "string"}
    },
    "additionalProperties": false
  }
}
